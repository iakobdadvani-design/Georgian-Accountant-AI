POSTGRES_USER=georgian_ai
POSTGRES_PASSWORD=changeme
POSTGRES_DB=georgian_ai_accountant

# Who reads messages / writes replies: auto | claude | ollama | off
#   auto   -> Claude if ANTHROPIC_API_KEY is set, otherwise offline (keywords + templates)
#   ollama -> a local model via Ollama (free, nothing leaves your machine)
AI_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
OLLAMA_MODEL=qwen2.5:14b
# Local models write poor Georgian; by default they only read messages and replies use templates.
OLLAMA_REPLIES=false

# Accountants who may sign off rules and deadlines (comma-separated emails of their app accounts).
REVIEWER_EMAILS=

# Deadline reminders (bell icon next to your account). Either or both; empty -> off.
# Email: any SMTP account. Gmail: smtp.gmail.com, port 587, your address, and an App Password
# (Google account -> Security -> App passwords), not your normal password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Telegram: create a bot with @BotFather and paste its token. No public URL needed.
TELEGRAM_BOT_TOKEN=

# RS.ge taxpayer lookup (name + VAT status for a tax ID). Create a "service user" in your
# eservices.rs.ge account (waybills -> service users) and put it here. Empty -> lookup off.
RS_SERVICE_USER=
RS_SERVICE_PASSWORD=

# Folder containing rad_law's laws.sqlite3 (legal citations). Relative to this file.
LAW_INDEX_DIR=../rag law/RAD law/data/index
